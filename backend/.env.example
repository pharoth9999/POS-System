# --- App ---
NODE_ENV=development
PORT=3000
# Comma-separated exact origins of the frontend(s). "*" is not allowed.
CORS_ORIGIN=http://localhost:5173

# --- Database (also used by infra/docker-compose.yml; 5433 avoids clashing with a local Postgres) ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=pos
DB_PASS=pos_password
DB_NAME=pos

# --- Telegram (receipts + low-stock alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Seed (npm run seed) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
